          {
            "node": "Write it to the mounted folder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run on demand": {
      "main": [
        [
          {
            "node": "POST /api/v1/reports/generate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
