      "position": [
        -260,
        0
      ],
      "webhookId": "33fc57ba-a350-4554-9c69-42142377095e"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Map the storefront payload onto the RelayOps canonical order and sign it.\n// The signature covers the EXACT bytes the HTTP node sends, so the body string\n// built here is the body posted downstream - never a re-serialised object.\nconst crypto = require('crypto');\n\nconst secret = $env.RELAYOPS_WEBHOOK_SECRET;\nif (!secret) {\n  throw new Error('RELAYOPS_WEBHOOK_SECRET is not set on the n8n container');\n}\n\nconst incoming = $input.first().json;\nconst order = incoming.body ?? incoming;\n\nconst payload = {\n  order_id: String(order.order_id ?? order.id ?? order.order_number ?? ''),\n  store: order.store ?? order.store_name ?? (order.location && order.location.name) ?? '',\n  amount: Number(order.amount ?? order.total_price ?? order.total ?? 0),\n  currency: order.currency ?? 'USD',\n  status: order.status ?? order.financial_status ?? 'paid',\n  created_at: order.created_at ?? order.processed_at ?? new Date().toISOString(),\n  channel: 'n8n-order-intake',\n};\n\nconst body = JSON.stringify(payload);\nconst timestamp = Math.floor(Date.now() / 1000);\nconst digest = crypto.createHmac('sha256', secret).update(timestamp + '.' + body).digest('hex');\n\nreturn [{\n  json: {\n    body: body,\n    order_id: payload.order_id,\n    signature: 't=' + timestamp + ',v1=' + digest,\n    idempotency_key: 'n8n-order-' + payload.order_id,\n  },\n}];\n"
      },
      "id": "936d5dab072b4e8f",
      "name": "Map and sign",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RELAYOPS_BASE_URL }}/api/v1/webhooks/orders",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-RelayOps-Signature",
              "value": "={{ $json.signature }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.idempotency_key }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}"
      },
      "id": "ee6ec45a8ca9494e",
