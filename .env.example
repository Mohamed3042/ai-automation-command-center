# RelayOps configuration. Every value is optional: with none of them set the
# server runs keyless, offline, and reproducible, exactly as in v1.1.
# Copy to .env for Docker Compose (`docker compose --env-file .env up`).

# ---------------------------------------------------------------- inbound webhooks
# Signing secret for POST /api/v1/webhooks/{orders,tickets}.
# The database seeds a DEVELOPMENT value that is published in this repository so a
# fresh clone can sign its own test request. Set these in any real deployment.
RELAYOPS_WEBHOOK_SECRET=
RELAYOPS_WEBHOOK_SECRET_ORDERS=
RELAYOPS_WEBHOOK_SECRET_TICKETS=

# ---------------------------------------------------------------- outbound webhooks
# Base delay for the delivery backoff, in seconds (attempt n waits base * 2^(n-1), capped at 300).
RELAYOPS_WEBHOOK_BACKOFF_SECONDS=5
# Register one subscription at startup instead of calling the API (used by Compose and CI).
RELAYOPS_BOOTSTRAP_SUBSCRIPTION_NAME=n8n-alert-escalation
RELAYOPS_BOOTSTRAP_SUBSCRIPTION_URL=
RELAYOPS_BOOTSTRAP_SUBSCRIPTION_SECRET=
RELAYOPS_BOOTSTRAP_SUBSCRIPTION_EVENTS=alert.*

# ---------------------------------------------------------------- API keys
# Install a known token at startup so a container is usable without an interactive
# `python server.py keys create`. Generate your own; never commit one.
RELAYOPS_BOOTSTRAP_API_KEY=
RELAYOPS_BOOTSTRAP_API_KEY_NAME=bootstrap
RELAYOPS_BOOTSTRAP_API_KEY_SCOPES=*

# ---------------------------------------------------------------- connectors
# With this set, alert escalations are posted to Slack as Block Kit messages.
# Without it, the identical payload is recorded as a fixture receipt and labelled
# "fixture" in the UI.
SLACK_WEBHOOK_URL=
# Absolute base used in the "Open alert timeline" button of Slack messages.
RELAYOPS_PUBLIC_URL=http://127.0.0.1:4173

# ---------------------------------------------------------------- runtime
# json (default) or text.
RELAYOPS_LOG_FORMAT=json
# Path to the SQLite file inside the container.
RELAYOPS_DB=/data/command_center.db

# ---------------------------------------------------------------- optional LLM provider
RELAYOPS_LLM_API_KEY=
RELAYOPS_LLM_MODEL=gpt-4.1-mini
RELAYOPS_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
